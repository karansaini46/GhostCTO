generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FOUNDER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  ARCHIVED
}

enum ChatMessageRole {
  FOUNDER
  ADVISOR
  SYSTEM
}

enum PaymentProvider {
  GUMROAD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum BillingPlan {
  FREE
  LIFETIME
}

enum GeneratedDocumentFeedbackUsefulness {
  USEFUL
  NEEDS_WORK
  WRONG
}

enum GeneratedDocumentFeedbackIssueType {
  MISSING_CONTEXT
  INCORRECT_CONTENT
  TOO_GENERIC
  MISSING_DETAIL
  HARD_TO_ACT_ON
  OTHER
}

model User {
  id              String              @id @default(uuid()) @db.Uuid
  email           String              @unique
  passwordHash    String?
  name            String?
  avatarUrl       String?
  supabaseUserId  String?             @unique
  googleAccountId String?             @unique
  role            UserRole            @default(FOUNDER)
  plan            BillingPlan         @default(FREE)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)
  projects        Project[]
  answers         ProjectAnswer[]
  documents       GeneratedDocument[]
  chatMessages    ChatMessage[]
  auditReports    AuditReport[]
  quoteAnalyses   QuoteAnalysis[]
  vettingReports  VettingReport[]
  payments        Payment[]
  refreshTokens   RefreshToken[]
  documentFeedback GeneratedDocumentFeedback[]

  @@index([createdAt])
  @@index([plan])
}

model Project {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  slug           String
  name           String
  companyName    String?
  stage          String?
  industry       String?
  websiteUrl     String?
  summary        String?
  ideaSummary    String?
  targetCustomer String?
  productType    String?
  monetization   String?
  currentStage   String?
  budgetRange    String?
  launchTimeline String?
  founderTechnicalLevel String?
  existingAssets Json                @default("[]")
  mustHaveFeatures Json              @default("[]")
  biggestConcern String?
  status         ProjectStatus       @default(DRAFT)
  context        Json                @default("{}")
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers        ProjectAnswer[]
  documents      GeneratedDocument[]
  chatMessages   ChatMessage[]
  auditReports   AuditReport[]
  quoteAnalyses  QuoteAnalysis[]
  vettingReports VettingReport[]
  payments       Payment[]
  documentFeedback GeneratedDocumentFeedback[]

  @@unique([id, userId])
  @@unique([userId, slug])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ProjectAnswer {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  type      String
  key       String
  label     String?
  answer    Json
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@index([createdAt])
}

model GeneratedDocument {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  projectId   String?    @db.Uuid
  type        String
  status      WorkStatus @default(PENDING)
  title       String
  summary     String?
  content     String?
  metadata    Json       @default("{}")
  version     Int        @default(1)
  completedAt DateTime?  @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  feedback    GeneratedDocumentFeedback[]

  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([projectId, type, version])
  @@index([createdAt])
}

model GeneratedDocumentFeedback {
  id           String                              @id @default(uuid()) @db.Uuid
  userId       String                              @db.Uuid
  projectId    String                              @db.Uuid
  documentId   String                              @db.Uuid
  documentType String
  rating       Int                                 @db.SmallInt
  usefulness   GeneratedDocumentFeedbackUsefulness
  issueType    GeneratedDocumentFeedbackIssueType?
  comment      String?
  createdAt    DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                            @updatedAt @db.Timestamptz(6)
  user         User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project                             @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  document     GeneratedDocument                   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
  @@index([projectId])
  @@index([documentId])
  @@index([documentType])
  @@index([rating])
  @@index([createdAt])
}

model ChatMessage {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  projectId String?         @db.Uuid
  role      ChatMessageRole
  content   String
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @db.Timestamptz(6)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?        @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([role])
  @@index([createdAt])
}

model AuditReport {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  projectId   String?    @db.Uuid
  type        String
  status      WorkStatus @default(PENDING)
  title       String
  summary     String?
  findings    Json       @default("[]")
  metadata    Json       @default("{}")
  completedAt DateTime?  @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model QuoteAnalysis {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  projectId   String?    @db.Uuid
  type        String
  status      WorkStatus @default(PENDING)
  vendorName  String?
  quoteAmount Decimal?   @db.Decimal(12, 2)
  currency    String?    @db.VarChar(3)
  summary     String?
  result      Json       @default("{}")
  metadata    Json       @default("{}")
  completedAt DateTime?  @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model VettingReport {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  projectId   String?    @db.Uuid
  type        String
  status      WorkStatus @default(PENDING)
  subjectName String?
  summary     String?
  criteria    Json       @default("[]")
  result      Json       @default("{}")
  metadata    Json       @default("{}")
  completedAt DateTime?  @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @db.Uuid
  projectId          String?         @db.Uuid
  type               String
  provider           PaymentProvider @default(GUMROAD)
  providerPaymentId  String
  providerCustomerId String?
  providerProductId  String?
  amountCents        Int
  currency           String          @default("USD") @db.VarChar(3)
  status             PaymentStatus   @default(PENDING)
  metadata           Json            @default("{}")
  paidAt             DateTime?       @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId])
  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
}
